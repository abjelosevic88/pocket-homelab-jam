[Unit]
Description=Pocket Jam — record music track by track, with a click, a tuner and a metronome
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-jam
Group=pocket-jam
ExecStart=/usr/local/bin/pocket-jam
Environment=DATA_DIR=/var/lib/pocket-jam
Environment=PORT=8080
Environment=BASE_URL=https://jam.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-jam
PrivateTmp=true

[Install]
WantedBy=multi-user.target
